<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Tests are not held to the production analyzer stack. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

  <!-- The blocked and empty-but-legitimate fixtures. They live in the repo as real files so
       the pair can be read side by side and corrected as bot walls change. -->
  <ItemGroup>
    <Content Include="Fixtures\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roadbed.Net.Mcp\Roadbed.Net.Mcp.csproj" />
  </ItemGroup>

  <!-- FetchService derives from Roadbed.Common.BaseClassWithLogging, so the compiler needs
       the vendored assembly visible to bind the base type. -->
  <ItemGroup>
    <Reference Include="Roadbed.Common">
      <HintPath>..\Roadbed.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
